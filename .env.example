SABY_BASE_URL=https://online.sbis.ru
SABY_LOGIN=
SABY_PASSWORD=CHANGE_ME
SABY_PAGE_SIZE=200
# Предел страниц реестра за один прогон. Реестр СБИС не применяет фильтр по
# датам и отсортирован по времени события, а не по дате документа, поэтому
# остановиться «дойдя до начала периода» нельзя — он читается целиком. Обрезка
# по этому пределу означает дыру в выборке и попадает в отчёт отдельной строкой.
SABY_MAX_PAGES=30
# Типы документов реестра, которые нас касаются. ДокОтгрВх — входящий УПД.
# Остальное (договоры, акты сверки, корректировки, счета, транспортные
# накладные) суммы в событии не имеет по природе: на живом реестре это 1086 из
# 2739 событий, и без фильтра они шли в счётчик «не удалось разобрать».
# Пусто — без фильтра.
SABY_DOCUMENT_TYPES=ДокОтгрВх
# Повторы чтения одной страницы реестра. Чтение идемпотентно, а обрыв TLS на
# одной странице из тридцати валил весь прогон в одну техническую ошибку.
SABY_PAGE_RETRIES=3
SABY_RETRY_DELAY_SECONDS=2
# Файл сессии pysaby. По умолчанию библиотека кладёт его внутрь
# site-packages, где он теряется при переустановке зависимостей и не
# создаётся вовсе в окружении только для чтения.
SABY_SESSION_PATH=state/saby_session.db

# Базовый адрес публикации HTTP-сервисов 1С, например
# https://internal.internal.internal.example.invalid/exchangedb/hs/main
ONE_S_BASE_URL=
ONE_S_USERNAME=
ONE_S_PASSWORD=CHANGE_ME
# Запись в продуктивную 1С запрещена. Не включать без отдельного согласования.
ONE_S_WRITES_ENABLED=false
# Ключ для POST /sync/run (заголовок X-API-Key). При ONE_S_WRITES_ENABLED=true
# обязателен: иначе запуск с записью в продуктив открыт всем, и сервис не стартует.
SYNC_API_KEY=CHANGE_ME
# Где слушает сервис. Для формы подтверждения с рабочих мест нужен адрес,
# видимый в сети: APP_HOST=service.example.invalid. На своей машине хватает localhost.
APP_HOST=127.0.0.1
APP_PORT=8000
# Программа не принимает решений сама: даже когда кандидат единственный и все
# проверки пройдены, запись выполняется только после подтверждения сотрудником
# через форму. Включать автоматическую запись можно будет тогда, когда на
# накопленных подтверждениях станет видно, что доля ошибок остаётся нулевой.
ONE_S_AUTO_WRITE_ENABLED=false

# Группы складов из справочника /data1C/warehouse, для которых разрешена
# автоматическая обработка. Группы "Москва" в 1С не существует: московские
# склады лежат в группе ОСНОВНЫЕ.
ONE_S_ALLOWED_WAREHOUSE_GROUPS=ОСНОВНЫЕ
# Виды доп. расходов, которые обрабатываются автоматически.
ONE_S_ALLOWED_EXPENSE_TYPES=Фрахт,ЖД РФ
# Имя строки с фактической датой автовывоза. Пока 1С не передаёт табличные
# части заказа, проверка по ней невозможна и документы уходят в ручную обработку.
ONE_S_AUTO_PICKUP_ROW_NAME=Дата автовывоза со станции/порта = Пост.
# Запасной путь: имя плоского поля заказа с фактической датой автовывоза, если
# 1С однажды начнёт отдавать её прямо в ordertosupplier. Обычно не нужно — дата
# берётся из метода ordertosupplierattributes.
ONE_S_AUTO_PICKUP_FIELDS=

# Заказы поставщику нельзя фильтровать по номеру, поэтому они читаются
# кусками по несколько месяцев, от свежих к старым.
ONE_S_BULK_CHUNK_DAYS=92
ONE_S_BULK_MAX_CHUNKS=8
ONE_S_BULK_TIMEOUT_SECONDS=120
# Запас по границам периода: включительность periodEnd в 1С не подтверждена.
ONE_S_ORDER_DATE_SLACK_DAYS=1

# Сопоставление документов. ИНН обмен с 1С не отдаёт, поэтому контрагент
# сверяется по наименованию, а решение принимается по сумме сигналов.
#
# Порог 40 выбран по замеру на эталоне: 46 пар, которые бухгалтер связал руками
# (номер входящего в 1С в точности равен номеру документа Saby). При стёртых
# реквизитах — то есть в том состоянии, в котором документы и приходят —
# порог 60 не находит НИ ОДНОЙ пары: оба сильных сигнала недоступны. Номер УПД
# в реквизитах — это ровно то, что мы вписываем, а номер заказа поставщику Saby
# не отдаёт ни у одного документа. Остаётся контрагент + организация + близкая
# дата = 50 баллов.
#   порог 60: верно 0,  ошибок 0, неоднозначно 0, не найдено 46
#   порог 50: верно 8,  ошибок 0, неоднозначно 3, не найдено 35
#   порог 40: верно 11, ошибок 0, неоднозначно 6, не найдено 29
# Ошибочных выборов нет ни при каком пороге: запас в 20 баллов уводит спорные
# случаи в «неоднозначно», а не в неверную запись.
MATCH_MIN_SCORE=40
MATCH_SCORE_MARGIN=20
MATCH_NAME_SIMILARITY=0.85
MATCH_DATE_WINDOW_DAYS=45
# Доп. расход в 1С может быть проведён и раньше, и позже УПД.
EXPENSE_LOOKBACK_DAYS=45
EXPENSE_LOOKAHEAD_DAYS=14
# Разрешать дозаполнение, когда в 1С проставлен только номер или только дата.
ALLOW_COMPLETING_PARTIAL_REQUISITES=true

# Файл с датой последнего обработанного периода. Нужен, чтобы пропуск запусков
# дольше SYNC_WINDOW_DAYS не оставлял дыру в выборке. Окно он только расширяет.
SYNC_STATE_PATH=state/sync_state.json

# Форма подтверждения разноски. Код доступа приходит в письме с отчётом;
# входа по логину и паролю нет.
CONFIRM_ENABLED=true
# Адрес, по которому форма доступна сотруднику — попадает ссылкой в письмо.
# Если не задан, письмо уйдёт с кодом, но без ссылки, и сервис предупредит об
# этом при старте.
CONFIRM_BASE_URL=
CONFIRM_PENDING_PATH=state/pending.json
# Журнал решений: кто и что разрешил записать. Не ротируется и не чистится.
CONFIRM_JOURNAL_PATH=state/confirmations.jsonl
# Код срабатывает ОДИН раз: открыл сессию — погас. Сама сессия живёт
# CONFIRM_SESSION_MINUTES и продлевается при каждом действии.
CONFIRM_CODE_TTL_HOURS=48
CONFIRM_SESSION_MINUTES=30
# Пороги мягкие намеренно. От подбора защищает длина кода (10 знаков из
# 32-буквенного алфавита), а счётчик ведётся по выходному адресу: за NAT он
# общий на весь офис, и жёсткая пауза закрывала бы форму всем из-за чужих
# опечаток.
CONFIRM_MAX_ATTEMPTS=10
CONFIRM_LOCKOUT_MINUTES=5
CONFIRM_RESEND_INTERVAL_MINUTES=5
# Период запоминается только при чистом прогоне: обрезка max_documents,
# любая техническая ошибка или конец периода в будущем оставляют его
# непройденным, чтобы следующий запуск к нему вернулся.

SYNC_WINDOW_DAYS=14
SYNC_MAX_LOOKBACK_DAYS=180
SYNC_MAX_ATTEMPTS=2
SYNC_START_DATE=2026-01-01
AMOUNT_TOLERANCE=0.01
DEFAULT_ORGANIZATION_NAME=

# SMTP. Можно использовать эти имена или EMAIL_* алиасы ниже.
# REPORT_BACKEND=smtp отправляет письма.
# REPORT_BACKEND=console печатает письмо в терминал и ничего не отправляет.
# REPORT_BACKEND=both печатает в терминал и отправляет по SMTP.
# REPORT_BACKEND=none отключает отчеты.
REPORT_BACKEND=smtp
# Адрес почтового сервера. Если сервис работает вне того сегмента, где
# резолвится внутреннее имя, указывайте IP: сертификат при STARTTLS не
# проверяется, поэтому адрес числом работает без оговорок.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=
SMTP_TO=
ERROR_EMAIL_TO=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_SUBJECT_PREFIX=[Saby/1C]
SMTP_ATTACH_REPORT=true
SMTP_REPORT_FORMAT=xlsx
SMTP_MAX_ATTACHMENT_MB=10
# Предел ожидания SMTP. Без него зависший почтовый сервер держит поток
# планировщика, и процесс перестаёт гаситься.
SMTP_TIMEOUT_SECONDS=30
REPORT_DIR=reports
# Сколько файлов отчётов хранить. 0 — не чистить. Каталог растёт на файл за
# прогон, и за полгода в нём сотни файлов.
REPORT_KEEP_FILES=90

# Встроенный ежедневный планировщик: работает внутри процесса сервиса,
# cron и планировщик задач Windows не нужны.
DAILY_SYNC_ENABLED=false
# HH:MM или HH:MM:SS.
DAILY_SYNC_TIME=17:00
DAILY_SYNC_TIMEZONE=Europe/Moscow
# Запрет записи (ONE_S_WRITES_ENABLED=false) планировщик не выключает: прогон
# просто становится холостым. Это и есть режим наблюдения перед включением записи.
DAILY_SYNC_DRY_RUN=true
DAILY_SYNC_SEND_REPORT=true

# SMTP aliases for Django-style environment names.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
EMAIL_TO=
# Django-style alias: django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=

REQUEST_TIMEOUT_SECONDS=30

# Логирование. Без настройки все сообщения уровня INFO теряются, а
# предупреждения уходят без времени и уровня — ночной прогон нечем разбирать.
LOG_LEVEL=INFO
# Путь к файлу лога. Пусто — только stderr (под systemd его подхватит
# journald). Ротация суточная: старые файлы получают суффикс с датой,
# sync.log.2026-09-15 — потому что вопрос к логу всегда звучит как
# «что было четырнадцатого», а не «что было в предыдущем мегабайте».
LOG_FILE=logs/sync.log
# Сколько суток хранить.
LOG_BACKUP_DAYS=30
